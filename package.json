  "devDependencies": {
    "@types/chrome": "^0.1.1",
    "@types/react": "~19.2.4",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "~4.21.0",
    "typescript": "~6.0.3",
    "vite": "^7.0.0"
